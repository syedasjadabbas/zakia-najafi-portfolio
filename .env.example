# Copy to .env.local (development) or set in your host's environment (production).

# Public address of the site, used for canonical URLs, sitemap, Open Graph and links in emails.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# PostgreSQL connection string. Required in production.
# Without it, development uses an embedded database in ./.data/pglite.
DATABASE_URL=

# Administrator sign-in at /admin.
ADMIN_PASSWORD=
# Random string of at least 32 characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
SESSION_SECRET=

# "manual" (default): payment instructions in src/content/site.ts + admin verification.
# "stripe": Stripe Checkout, confirmed by webhook.
PAYMENT_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional transactional email via Resend. Without it, registrants rely on their private link.
RESEND_API_KEY=
EMAIL_FROM="Zakia Batool Najafi <lectures@example.com>"

# Development only: show fictional sample lectures to try the registration flow.
SHOW_EXAMPLE_LECTURES=false
